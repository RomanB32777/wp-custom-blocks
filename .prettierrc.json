{
	"trailingComma": "es5",
	"printWidth": 80,
	"semi": true,
	"useTabs": true,
	"tabWidth": 2,
	"singleQuote": false,
	"plugins": [
		"@ianvs/prettier-plugin-sort-imports",
		"prettier-plugin-tailwindcss",
		"@wordpress/prettier-config"
	],
	"importOrder": [
		"<BUILTIN_MODULES>",

		"",

		"^react$",
		"<THIRD_PARTY_MODULES>",
		"^@wordpress/(.*)$",

		"",

		"^@/(.*)$",

		"",

		"^../(.*)$",
		"^./(.*)[^(.scss)]$",
		"^[.]",

		"",

		"(.scss)$"
	]
}
